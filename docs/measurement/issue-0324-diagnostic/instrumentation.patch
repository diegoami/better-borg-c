+/* Disposable diagnostic for the D0012 retreat/re-approach analysis
+ * (better-borg-c #324).  Strictly observational: writes only to the file
+ * named by BORG_DIAG324 (silent when unset).  Never touches decisions,
+ * RNG or the recorded streams. */
+#include <stdarg.h>
+#include <game-world.h>
+static FILE *diag324_file = NULL;
+void diag324(const char *fmt, ...)
+{
+    va_list ap;
+    if (!diag324_file) {
+        const char *path = getenv("BORG_DIAG324");
+        if (!path) return;
+        diag324_file = fopen(path, "a");
+        if (!diag324_file) return;
+    }
+    va_start(ap, fmt);
+    vfprintf(diag324_file, fmt, ap);
+    va_end(ap);
+    fputc('\n', diag324_file);
+    fflush(diag324_file);
+}
+
 bool borg_caution(void)
 {
     int  j, pos_danger;
