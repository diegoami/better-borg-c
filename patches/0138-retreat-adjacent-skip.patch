From 3b0a9467344b461a1d0177877dc190b17aee08e4 Mon Sep 17 00:00:00 2001
From: Diego Amicabile <diego.amicabile@soprasteria.com>
Date: Fri, 13 Nov 2026 17:40:20 +0000
Subject: [PATCH] Borg: skip a strategic-retreat step next to a faster monster

The strategic retreat checks, for the first step of each candidate route,
whether the landing grid is next to a monster faster than the borg ("He
will just hit me when I land on that grid"). The break only left the
monster scan, so the test had no effect and the step was taken anyway.

Record the match and skip that route.
---
 src/borg/borg-caution.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/borg/borg-caution.c b/src/borg/borg-caution.c
index 52e3eb392..94e4fa97a 100644
--- a/src/borg/borg-caution.c
+++ b/src/borg/borg-caution.c
@@ -1438,6 +1438,7 @@ bool borg_caution(void)
         int b_x = borg.c.x;
         int b_y = borg.c.y;
         int ii;
+        bool adjacent_fast;
 
         /* Scan the useful viewable grids */
         for (j = 1; j < borg_view_n; j++) {
@@ -1577,6 +1578,7 @@ bool borg_caution(void)
                      * Skip this grid if it is adjacent to a monster.  He will
                      * just hit me when I land on that grid.
                      */
+                    adjacent_fast = false;
                     for (ii = 1; ii < borg_kills_nxt; ii++) {
                         borg_kill *kill;
 
@@ -1594,9 +1596,13 @@ bool borg_caution(void)
                         /* Check distance -- 1 grid away */
                         if (distance(kill->pos, loc(x1, y1)) <= 1
                             && kill->speed > borg.trait[BI_SPEED]
-                            && !borg_surround)
+                            && !borg_surround) {
+                            adjacent_fast = true;
                             break;
+                        }
                     }
+                    if (adjacent_fast)
+                        break;
                 }
 
                 /* Skip monsters */
