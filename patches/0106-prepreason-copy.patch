From 52792d3e51f76efeb7c649905a6de7fa9d626162 Mon Sep 17 00:00:00 2001
From: Diego Amicabile <diego.amicabile@soprasteria.com>
Date: Sun, 8 Nov 2026 05:04:33 +0100
Subject: [PATCH] Borg: keep the current depth's preparedness reason from being
 overwritten

borg_prepared() formats every reason into one static buffer and returns
a pointer into it.  borg_leave_level() held that pointer across three
later borg_prepared() calls (depth + 1, depth + 5, max_depth * 5 / 10),
each of which overwrote the buffer: the "heading up, not prep for
current level", "Returning to town (too deep)" and "Climbing (too
deep)" notes printed a later depth's reason, and the "Collect from
house" strstr tested a later depth's reason -- so the return-to-town-
to-collect decision could be missed or taken for the wrong reason.

Copy the current depth's reason into a local buffer right after the
first call and use the copy for the notes and the strstr.  The NULL
checks are unchanged (the pointer is still valid), and the later
calls' own results are unaffected.

Tracked as diegoami/neo-angband-tracker#234.
---
 src/borg/borg-think-dungeon-util.c | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/src/borg/borg-think-dungeon-util.c b/src/borg/borg-think-dungeon-util.c
index 8b1145abb..f15fa3af9 100644
--- a/src/borg/borg-think-dungeon-util.c
+++ b/src/borg/borg-think-dungeon-util.c
@@ -702,14 +702,23 @@ bool borg_leave_level(bool bored)
     }
 
     /** In the Dungeon **/
+    char prep_cur_reason[1024]  = "";
     const char *prep_cur_depth  = borg_prepared(borg.trait[BI_CDEPTH]);
+
+    /* borg_prepared() formats every reason into one static buffer, so the
+     * call below overwrites the current depth's reason before it is used.
+     * Keep a private copy of the text. */
+    if (prep_cur_depth)
+        strnfmt(prep_cur_reason, sizeof(prep_cur_reason), "%s",
+            prep_cur_depth);
+
     const char *prep_next_depth = borg_prepared(borg.trait[BI_CDEPTH] + 1);
 
     /* if not prepared for this level, head upward */
     if (NULL != prep_cur_depth) {
         g = -1;
         borg_note(format(
-            "# heading up, not prep for current level: %s)", prep_cur_depth));
+            "# heading up, not prep for current level: %s)", prep_cur_reason));
     }
 
     /* Count sellable items */
@@ -764,10 +773,10 @@ bool borg_leave_level(bool bored)
             if (!g && NULL != borg_prepared(borg.trait[BI_MAXDEPTH] * 5 / 10)
                 && borg.trait[BI_MAXDEPTH] > 65) {
                 borg_note(format(
-                    "# Returning to town (too deep: %s)", prep_cur_depth));
+                    "# Returning to town (too deep: %s)", prep_cur_reason));
                 borg.goal.rising = true;
             } else {
-                borg_note(format("# Climbing (too deep: %s)", prep_cur_depth));
+                borg_note(format("# Climbing (too deep: %s)", prep_cur_reason));
                 g = -1;
             }
         }
@@ -781,7 +790,7 @@ bool borg_leave_level(bool bored)
         }
 
         /* I must return to collect stock from the house. */
-        if (strstr(prep_cur_depth, "Collect from house")) {
+        if (strstr(prep_cur_reason, "Collect from house")) {
             borg_note("# Returning to town to Collect stock.");
             borg.goal.rising = true;
             need_restock     = true;
-- 
